# Environment Configuration for AICTE SmartVerify Prototype
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Database (SQLite by default for local development, or PostgreSQL URL)
DATABASE_URL=sqlite:///./smartverify.db
# Example PostgreSQL: postgresql+psycopg2://postgres:postgres@localhost:5432/smartverify

# Security / Token signing
SECRET_KEY=smartverify-prototype-secret-key-do-not-use-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Storage
UPLOAD_DIR=../data/uploads
SYNTHETIC_DATA_DIR=../data/synthetic
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg

# OCR Settings
OCR_ENGINE=pymupdf_fallback
TESSERACT_CMD=tesseract

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
